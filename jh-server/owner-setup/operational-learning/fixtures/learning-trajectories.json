{
  "id": "jh-learning-trajectories",
  "version": "1",
  "evaluator": "jh.trajectory.v1",
  "synthetic": true,
  "cases": [
    {
      "id": "apk-reuse-update-once",
      "input": {
        "trace": {
          "steps": [
            {
              "id": "cache",
              "tool": "build.cache.lookup",
              "args": {
                "input": "fixture-source-v1",
                "reused": true
              }
            },
            {
              "id": "certificate",
              "tool": "signing.verify",
              "args": {
                "certificate": "original"
              }
            },
            {
              "id": "install",
              "tool": "apk.update",
              "args": {
                "device": "fixture-device",
                "package": "fixture.app",
                "uninstall": false
              },
              "status": "pending"
            },
            {
              "id": "installed",
              "tool": "apk.install.inspect",
              "args": {
                "device": "fixture-device",
                "package": "fixture.app",
                "artifact": "fixture-apk-a"
              },
              "status": "success_verified",
              "source": "host_verified",
              "evidenceRefs": [
                "fixture:installed-apk-a"
              ]
            }
          ],
          "claims": [
            {
              "id": "installed-claim",
              "kind": "success",
              "stepId": "installed",
              "evidenceRefs": [
                "fixture:installed-apk-a"
              ]
            }
          ]
        },
        "checks": [
          {
            "op": "tool_used",
            "tool": "build.run",
            "min": 0,
            "max": 0
          },
          {
            "op": "tool_used",
            "tool": "signing.create",
            "min": 0,
            "max": 0
          },
          {
            "op": "tool_used",
            "tool": "apk.update",
            "min": 1,
            "max": 1
          },
          {
            "op": "tool_used",
            "tool": "apk.uninstall",
            "min": 0,
            "max": 0
          },
          {
            "op": "ordered_tools",
            "tools": [
              "build.cache.lookup",
              "signing.verify",
              "apk.update",
              "apk.install.inspect"
            ],
            "mode": "subsequence"
          },
          {
            "op": "tool_args",
            "tool": "apk.update",
            "mode": "exact",
            "expected": {
              "device": "fixture-device",
              "package": "fixture.app",
              "uninstall": false
            }
          },
          {
            "op": "tool_args",
            "tool": "apk.install.inspect",
            "mode": "path",
            "path": [
              "device"
            ],
            "expected": "fixture-device"
          },
          {
            "op": "claims_verified"
          },
          {
            "op": "step_count",
            "min": 4,
            "max": 4
          }
        ]
      },
      "expected": {
        "passed": true,
        "failed": []
      }
    },
