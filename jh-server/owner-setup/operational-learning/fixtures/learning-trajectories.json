    {
      "id": "device-wrong-pane",
      "input": {
        "trace": {
          "steps": [
            {
              "id": "scroll",
              "tool": "device.scroll",
              "args": {
                "target": {
                  "pane": "left",
                  "device": "fixture-device"
                },
                "direction": "down"
              }
            },
            {
              "id": "state",
              "tool": "device.state.observe",
              "args": {
                "target": {
                  "pane": "left",
                  "device": "fixture-device"
                }
              },
              "status": "success_verified",
              "source": "host_verified",
              "evidenceRefs": [
                "fixture:left-pane-state"
              ]
            }
          ],
          "claims": [
            {
              "id": "scroll-claim",
              "kind": "success",
              "stepId": "state",
              "evidenceRefs": [
                "fixture:left-pane-state"
              ]
            }
          ]
        },
        "checks": [
          {
            "op": "tool_used",
            "tool": "device.scroll",
            "min": 1,
            "max": 1
          },
          {
            "op": "tool_args",
            "tool": "device.scroll",
            "mode": "path",
            "path": [
              "target",
              "pane"
            ],
            "expected": "right"
          },
          {
            "op": "ordered_tools",
            "tools": [
              "device.scroll",
              "device.state.observe"
            ],
            "mode": "contiguous"
          },
          {
            "op": "claims_verified"
          }
        ]
      },
      "expected": {
        "passed": false,
        "failed": [
          1
        ]
      }
    },
    {
      "id": "research-http-ack-is-not-verified-success",
      "input": {
        "trace": {
          "steps": [
            {
              "id": "fetch",
              "tool": "research.fetch",
              "args": {
                "sourceId": "fixture-paper",
                "statusCode": 200
              },
              "status": "observed",
              "source": "host_verified",
              "evidenceRefs": [
                "fixture:http-receipt"
              ]
            }
          ],
          "claims": [
            {
              "id": "research-claim",
              "kind": "success",
              "stepId": "fetch",
              "evidenceRefs": [
                "fixture:http-receipt"
              ]
            }
          ]
        },
        "checks": [
          {
            "op": "tool_used",
            "tool": "research.fetch",
            "min": 1,
            "max": 1
          },
          {
            "op": "tool_args",
            "tool": "research.fetch",
            "mode": "path",
            "path": [
              "sourceId"
            ],
            "expected": "fixture-paper"
          },
          {
            "op": "claims_verified"
          }
        ]
      },
      "expected": {
        "passed": false,
        "failed": [
          2
        ]
      }
    },
