# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/playwright/mcp:v0.0.78

USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && curl -fsSL -o /tmp/tunnel-client.zip https://github.com/openai/tunnel-client/releases/download/v0.0.14/tunnel-client-v0.0.14-linux-amd64.zip \
    && unzip /tmp/tunnel-client.zip -d /tmp/tunnel-client \
    && install -m 0755 /tmp/tunnel-client/tunnel-client /usr/local/bin/tunnel-client \
    && rm -rf /var/lib/apt/lists/* /tmp/tunnel-client*

COPY --chmod=0755 render-entrypoint.sh /usr/local/bin/render-entrypoint.sh
COPY render-auth-proxy.mjs /usr/local/bin/render-auth-proxy.mjs
COPY render-auth-limiter.mjs /usr/local/bin/render-auth-limiter.mjs

ENTRYPOINT ["/usr/local/bin/render-entrypoint.sh"]
